# nginx in front of the portal (the portal listens on 127.0.0.1:8000). Put in /etc/nginx/conf.d/ and adjust the name and certificates.
# The portal must be served at the root of its own host name (its pages use absolute addresses such as /api/analyze).
server {
    listen 443 ssl http2;
    server_name ifacekit.example.org;
    ssl_certificate     /etc/ssl/certs/ifacekit.crt;
    ssl_certificate_key /etc/ssl/private/ifacekit.key;

    client_max_body_size 250m;            # structure 100 MB + AlphaFold full_data 100 MB + summary 5 MB
    proxy_read_timeout   1500s;           # an analysis can take up to 10 minutes, plus waiting for a free slot
    proxy_send_timeout   1500s;
    proxy_request_buffering off;

    location /static/ {                   # Mol* for the 3D pages: served by nginx directly
        alias /your_path/ifacekit/server/static/;
        expires 30d;
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
